{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ExpensesDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-min-32-characters-long-for-security",
    "Issuer": "ExpensesApi",
    "Audience": "ExpensesClient",
    "ExpirationMinutes": 60
  },
  "AIService": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
